POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_local_change_me
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# Local development: ollama. Official Qwen API: dashscope.
AI_PROVIDER=ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# json_object for broader endpoint compatibility; json_schema for supporting endpoints.
OPENROUTER_RESPONSE_FORMAT=json_object

DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
